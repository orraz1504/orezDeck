rules_version = '2';

// Each signed-in user can read and write only their own subtree:
//   users/{uid}/decks/{deckId}/cards/{cardId}
//   users/{uid}/images/{imageId}
//   users/{uid}/reviews/{id}
// Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /decks/{deckId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.roundNumber is int;

        match /cards/{cardId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.type in ['basic', 'cloze', 'image', 'problem']
            && request.resource.data.mastery is int
            && request.resource.data.mastery >= 0
            && request.resource.data.mastery <= 5;
        }
      }

      // One compressed image per document (base64 WebP data URL, < 1 MiB).
      match /images/{imageId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000
          && request.resource.data.width is int
          && request.resource.data.height is int;
      }

      match /reviews/{reviewId} {
        allow read, create, delete: if isOwner(uid);
      }
    }
  }
}
